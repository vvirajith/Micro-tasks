{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "workspaces": [
        "frontend"
    ],
    "scripts": {
        "dev": "npm run dev --workspace frontend",
        "build": "npm run build --workspace frontend",
        "lint": "npm run lint --workspace frontend",
        "typecheck": "npm run typecheck --workspace frontend",
        "blade:dev": "vite",
        "blade:build": "vite build",
        "dev:all": "concurrently -k -n laravel,next -c blue,magenta \"php artisan serve\" \"npm run dev --workspace frontend\""
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^2.0.0",
        "tailwindcss": "^4.0.0",
        "vite": "^7.0.7"
    }
}
