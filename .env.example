APP_NAME="Micro Task"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Origin of the Next.js app. Used for CORS and Sanctum stateful requests.
FRONTEND_URL=http://localhost:3000

# Frontend variables live in frontend/.env. Next reads the env files of its own
# project directory, so nothing in this file is exposed to the browser bundle.
SANCTUM_STATEFUL_DOMAINS=localhost:3000
# Extra comma-separated CORS origins, e.g. preview deployments.
CORS_ALLOWED_ORIGINS=
CORS_ALLOWED_ORIGIN_PATTERNS=
CORS_MAX_AGE=3600
# Minutes until an access token expires. Empty means never.
SANCTUM_TOKEN_EXPIRATION=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=micro_task
DB_USERNAME=root
DB_PASSWORD=

# Separate schema used by the test suite (see phpunit.xml).
DB_TEST_DATABASE=micro_task_testing

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@micro-task.test"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Seeded accounts (development only - never reuse production credentials)
# -----------------------------------------------------------------------------
# One password per admin in the UserSeeder roster. An entry left empty is
# skipped rather than seeded with a guessable default.
ADMIN_SUPER_PASSWORD=
ADMIN_ADITHYA_PASSWORD=
ADMIN_LAHIRU_PASSWORD=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
